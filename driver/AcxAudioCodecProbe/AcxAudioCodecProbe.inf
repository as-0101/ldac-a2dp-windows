[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=11/22/2026,1.0.0.0
CatalogFile=AcxAudioCodecProbe.cat
PnpLockDown=1

[DestinationDirs]
DefaultDestDir=13

[Manufacturer]
%StdMfg%=Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%DeviceDesc%=Audio_Device,ROOT\AudioCodec

[Audio_Device.NT]
CopyFiles=Audio_Device.NT.Copy

[Audio_Device.NT.Copy]
AcxAudioCodecProbe.sys

[Audio_Device.NT.Services]
AddService=AcxAudioCodecProbe,0x00000002,Audio_Service_Inst

[Audio_Service_Inst]
DisplayName=%DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\AcxAudioCodecProbe.sys

[Audio_Device.NT.Wdf]
KmdfService=AcxAudioCodecProbe,Audio_wdfsect

[Audio_wdfsect]
KmdfLibraryVersion=1.31

[SourceDisksNames]
1=%DiskId1%,,,""

[SourceDisksFiles]
AcxAudioCodecProbe.sys=1,,

[Strings]
ProviderName="ACX bind probe research"
StdMfg="ACX bind probe research"
DeviceDesc="ACX 1.0 AudioCodec bind probe"
DiskId1="ACX 1.0 AudioCodec bind probe"
